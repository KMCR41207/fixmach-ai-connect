# ─── Frontend (Vite) ───────────────────────────────────────────────────────────
# URL of the FastAPI backend. Use HTTPS in production.
VITE_API_URL=https://your-backend.onrender.com

# ─── Backend (FastAPI) ─────────────────────────────────────────────────────────
# Absolute path to the trained Keras model file.
MODEL_PATH=/opt/render/project/src/fixmach_mega_final.keras

# Comma-separated list of frontend origins allowed by CORS.
# Example: https://fixmach.ai,https://www.fixmach.ai
ALLOWED_ORIGINS=https://fixmach.ai,https://www.fixmach.ai
